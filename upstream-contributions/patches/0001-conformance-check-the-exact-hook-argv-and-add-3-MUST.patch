+++ b/adapter-toolkit/conformance/run.py
@@ -21,13 +21,16 @@ REQUIRED_CASES = (
     "hook-crash-fail-closed",
     "hung-hook-fail-closed",
     "key-removal-rewrite",
+    "missing-protocol-version",
     "output-rewrite",
