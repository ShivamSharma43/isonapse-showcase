+    "post-deny-without-output",
     "protocol-version-mismatch",
     "session-end-lifecycle",
     "stop-lifecycle",
     "unavailable-fail-closed",
+    "unknown-decision",
 )
 ALL_CAPABILITIES = {"can_ask", "can_rewrite_input", "can_rewrite_output"}
 
@@ -145,17 +148,11 @@ def run_case(
             failures.append("adapter never invoked the hook")
         else:
             argv = json.loads(argv_log.read_text(encoding="utf-8"))
-            try:
-                host_index = argv.index("--host")
-                protocol_index = argv.index("--adapter-protocol")
-                handshake_ok = (
-                    argv.count("--host") == 1
-                    and argv.count("--adapter-protocol") == 1
-                    and argv[host_index + 1] == expected_host
-                    and argv[protocol_index + 1] == "1"
-                )
-            except (ValueError, IndexError):
-                handshake_ok = False
+            # Rule 1: the native event, the registered host id and protocol 1,
+            # exactly. Checking only the flags let an adapter send the wrong
+            # event (or none) and still pass.
+            expected_event = fixture.get("expectedHookEvent", fixture["event"])
+            handshake_ok = argv == [expected_event, "--host", expected_host, "--adapter-protocol", "1"]
             if not handshake_ok:
                 failures.append(f"wrong hook handshake: {argv!r}")
         if request_log.exists() and request_log.read_text(encoding="utf-8") != request:
